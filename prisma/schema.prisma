generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  nameUz    String
  nameRu    String
  nameEn    String
  image     String?
  icon      String?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  sku         String?
  nameUz      String
  nameRu      String
  nameEn      String
  descUz      String?
  descRu      String?
  descEn      String?
  brand       String?
  /// Narx — so'mda, butun son
  price       Int
  /// Chegirmagacha bo'lgan narx (bo'lsa)
  oldPrice    Int?
  /// O'lchov birligi kaliti: piece | kg | ton | m2 | m3 | m | liter | bag | roll | pack | set
  unit        String      @default("piece")
  stock       Int         @default(0)
  image       String?
  /// Qo'shimcha rasmlar, JSON massiv sifatida
  images      String?
  isActive    Boolean     @default(true)
  isFeatured  Boolean     @default(false)
  sortOrder   Int         @default(0)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
}

model Order {
  id            String      @id @default(cuid())
  number        Int         @unique
  customerName  String
  phone         String
  address       String?
  comment       String?
  /// Yetkazib berish: delivery | pickup
  deliveryType  String      @default("delivery")
  /// cash | payme | click
  paymentMethod String      @default("cash")
  /// pending | paid | failed
  paymentStatus String      @default("pending")
  /// new | confirmed | delivering | done | cancelled
  status        String      @default("new")
  subtotal      Int
  deliveryFee   Int         @default(0)
  total         Int
  locale        String      @default("uz")
  tgUserId      String?
  tgUsername    String?
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  unit      String   @default("piece")
  price     Int
  qty       Int

  @@index([orderId])
}

model Setting {
  key   String @id
  value String
}
